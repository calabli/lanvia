#!/bin/sh
# The installer runs as root, so the installed files would be owned by root. Hand them
# to the currently logged in user, so Lanvia can replace itself on future auto updates without asking for the admin password every time.
user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ]; then
  /usr/sbin/chown -R "$user":staff "/Applications/Lanvia.app"
  # Open Lanvia as the current user once the install is done
  uid=$(id -u "$user")
  launchctl asuser "$uid" sudo -u "$user" open -a "/Applications/Lanvia.app" 2>/dev/null
fi
exit 0
